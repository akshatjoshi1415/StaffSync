# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Local MongoDB connection (default):
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync
# For MongoDB Atlas in Production on Render, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staffsync?retryWrites=true&w=majority

# JWT Authentication Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Frontend Client URL (for CORS)
# In local development:
CLIENT_URL=http://localhost:5174
# In production on Render:
# CLIENT_URL=https://your-frontend.vercel.app

# One-time HR Administrator Bootstrap Secret
# Generate a secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOTSTRAP_SECRET=your_bootstrap_admin_secret_here
